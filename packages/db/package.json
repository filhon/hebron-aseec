{
  "name": "@hebron/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./authenticated": "./src/authenticated.ts",
    "./audit": "./src/audit.ts",
    "./consents": "./src/consents.ts",
    "./anonymization": "./src/anonymization.ts",
    "./notifications": "./src/notifications.ts",
    "./settings": "./src/settings.ts",
    "./system-actor": "./src/system-actor.ts",
    "./meetings": "./src/meetings.ts",
    "./projetos-approval": "./src/projetos-approval.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@hebron/email": "workspace:*",
    "@hebron/types": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "drizzle-orm": "catalog:",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@hebron/eslint-config": "workspace:*",
    "@hebron/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}
