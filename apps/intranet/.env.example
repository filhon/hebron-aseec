# Supabase — cliente (todo app usa via @hebron/auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase — Admin API (apps/intranet/src/actions/profile.ts, lib/queries.ts:
# aceitação de convite, signed URL de avatar)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection (Drizzle — @hebron/db)
# Supabase Dashboard → Settings → Database → Connection String → URI (port 6543, Transaction Pooler)
DATABASE_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres

# URL base da intranet (login canônico do ecossistema — app.hebronaseec.com.br)
NEXT_PUBLIC_SITE_URL=http://localhost:3005
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Resend
RESEND_API_KEY=your-resend-api-key

# Inngest (packages/jobs, P-0.14) — jobs agendados/cron. Único app que
# registra a rota de serve (src/app/api/inngest/route.ts).
# Dev local: rode `npx inngest-cli@latest dev` e aponte para
# http://localhost:3005/api/inngest — não exige chaves em dev.
# Em produção (Inngest Cloud), preencher as duas:
INNGEST_SIGNING_KEY=your-inngest-signing-key
INNGEST_EVENT_KEY=your-inngest-event-key

# Upstash Redis (PACOTE 5) — rate limit de apps/intranet/src/actions/invitations.ts
# (acceptInvitation). Sem estas duas, packages/auth/src/rate-limit.ts cai
# num limitador em memória por instância — não protege de verdade em
# produção serverless (Vercel). Upstash Console → REST API.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Sentry (PACOTE 5) — captura de erro em produção. Sem DSN, o SDK desliga
# sozinho (dev/CI seguem funcionando sem isto configurado).
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Só necessárias para o upload de source maps no build (opcional — sem elas
# o Sentry só reporta stack traces minificados).
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=intranet
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Definido automaticamente pelo runtime Node/Next (development|test|production).
NODE_ENV=development
