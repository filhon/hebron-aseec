# Supabase — cliente (todo app usa via @hebron/auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Direct PostgreSQL connection (Drizzle — @hebron/db)
# Supabase Dashboard → Settings → Database → Connection String → URI (port 6543, Transaction Pooler)
DATABASE_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres

# URL do próprio app — usada para montar links em notificações/e-mails
NEXT_PUBLIC_RADIO_URL=http://localhost:3003

# Resend
RESEND_API_KEY=your-resend-api-key

# Cloudflare R2 (P-8.8) — armazenamento de faixas de áudio e materiais
# exclusivos, client S3-compatible (@aws-sdk/client-s3).
# Cloudflare Dashboard → R2 → Manage API Tokens.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=hebron-radio

# Upstash Redis (PACOTE 5) — rate limit de /api/heartbeat (POST anônimo a
# cada 60s por ouvinte). Sem estas duas, packages/auth/src/rate-limit.ts cai
# num limitador em memória por instância — não protege de verdade em
# produção serverless (Vercel). Upstash Console → REST API.
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Sentry (PACOTE 5) — captura de erro em produção. Sem DSN, o SDK desliga
# sozinho (dev/CI seguem funcionando sem isto configurado).
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Só necessárias para o upload de source maps no build (opcional — sem elas
# o Sentry só reporta stack traces minificados).
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=radio
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Definido automaticamente pelo runtime Node/Next (development|test|production).
NODE_ENV=development
