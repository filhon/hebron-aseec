# Supabase — cliente (todo app usa via @hebron/auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase — Admin API (apps/admin/src/actions/users.ts, lgpd.ts: criação de
# conta, listagem de usuários do Auth, execução de exclusão LGPD)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection (Drizzle — @hebron/db)
# Supabase Dashboard → Settings → Database → Connection String → URI (port 6543, Transaction Pooler)
DATABASE_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres

# URL da intranet (app.hebronaseec.com.br) — usada para montar links de
# volta em telas/e-mails do Admin.
NEXT_PUBLIC_APP_URL=http://localhost:3005

# Resend
RESEND_API_KEY=your-resend-api-key

# Impersonação (P-1.x) — segredo HMAC que assina o cookie
# `hb-impersonation`. Único app que grava/limpa o cookie. OBRIGATÓRIO em
# produção: sem ele, @hebron/auth/impersonation lança em runtime. Gere um
# valor aleatório forte, ex.: `openssl rand -base64 48`.
IMPERSONATION_COOKIE_SECRET=your-strong-random-secret

# Sentry (PACOTE 5) — captura de erro em produção. Sem DSN, o SDK desliga
# sozinho (dev/CI seguem funcionando sem isto configurado).
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Só necessárias para o upload de source maps no build (opcional — sem elas
# o Sentry só reporta stack traces minificados).
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=admin
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Definido automaticamente pelo runtime Node/Next (development|test|production).
NODE_ENV=development
