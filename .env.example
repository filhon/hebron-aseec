# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# URL base da intranet
NEXT_PUBLIC_SITE_URL=http://localhost:3005
NEXT_PUBLIC_APP_URL=http://localhost:3005

# URLs dos demais apps (links cross-app em notificações, busca e certificados —
# packages/config/src/env.ts). Opcionais: nenhum app é obrigado a declarar a
# URL de um app que não consome.
NEXT_PUBLIC_PLATAFORMA_URL=http://localhost:3002
NEXT_PUBLIC_RADIO_URL=http://localhost:3003
NEXT_PUBLIC_FINANCEIRO_URL=http://localhost:3004
NEXT_PUBLIC_DOCUMENTOS_URL=http://localhost:3006
NEXT_PUBLIC_FLATS_URL=http://localhost:3007
NEXT_PUBLIC_TAREFAS_URL=http://localhost:3008
NEXT_PUBLIC_PROJETOS_URL=http://localhost:3001

# Direct PostgreSQL connection (Drizzle Kit / migrations)
# Supabase Dashboard → Settings → Database → Connection String → URI (port 6543, Transaction Pooler)
DATABASE_URL=postgresql://postgres.[PROJECT]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres

# OpenAI (packages/ai) — triagem/scoring de projetos, OCR financeiro
OPENAI_API_KEY=your-openai-api-key

# Definido automaticamente pelo runtime Node/Next (development|test|production).
# Não precisa ser setado manualmente em .env — listado aqui só para inventário
# (packages/config/src/env.ts valida e default é "development").
NODE_ENV=development

# Impersonação (apps/admin, P-1.x) — segredo HMAC que assina o cookie
# `hb-impersonation`, tornando-o infalsificável (F3-13). OBRIGATÓRIO em
# produção: sem ele, @hebron/auth/impersonation lança em runtime. Gere um valor
# aleatório forte, ex.: `openssl rand -base64 48`.
IMPERSONATION_COOKIE_SECRET=your-strong-random-secret

# Resend
RESEND_API_KEY=your-resend-api-key

# Inngest (packages/jobs, P-0.14) — jobs agendados/cron
# Dev local: rode `npx inngest-cli@latest dev` e aponte para
# http://localhost:3005/api/inngest (a rota de serve, na intranet);
# não exige chaves em dev. Em produção (Inngest Cloud), preencher as duas:
INNGEST_SIGNING_KEY=your-inngest-signing-key
INNGEST_EVENT_KEY=your-inngest-event-key

# Seed de produção (packages/db/src/seed/producao.ts, PACOTE 5 / P-9.5) —
# só usadas por `pnpm --filter @hebron/db db:seed`, nunca em runtime de app.
# Identidades reais, não inventadas por código: sem estas variáveis o seed
# pula a criação de super_admin/designação com um aviso, não falha.
SEED_SUPER_ADMIN_1_EMAIL=admin1@hebronaseec.org.br
SEED_SUPER_ADMIN_1_NAME=Nome Completo
SEED_SUPER_ADMIN_2_EMAIL=admin2@hebronaseec.org.br
SEED_SUPER_ADMIN_2_NAME=Nome Completo
# E-mail de um usuário já existente (convidado) — designações não criam conta.
SEED_FINANCEIRO_GESTOR_EMAIL=
SEED_FINANCEIRO_AUTORIZADOR_EMAIL=
SEED_FLATS_GESTOR_EMAIL=

# Cloudflare R2 (apps/radio, P-8.8) — armazenamento de faixas de áudio e
# materiais exclusivos, client S3-compatible (@aws-sdk/client-s3).
# R2_ENDPOINT não estava na lista original de env vars do prompt P-8.8 (só
# citava R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY/R2_BUCKET) — sem ele não há
# como montar o client S3 (infra óbvia faltante, G1, registrada em
# SESSIONS.md). Cloudflare Dashboard → R2 → Manage API Tokens.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=hebron-radio